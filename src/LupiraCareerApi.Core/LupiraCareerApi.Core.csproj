<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Flow the `///` summaries into the OpenAPI document (host AND Core — the DTOs live in Core). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Marten is the event store + document store on Postgres. No ASP.NET dependency — that lives in the host. -->
    <PackageReference Include="Marten" Version="9.10.0" />
  </ItemGroup>

</Project>
